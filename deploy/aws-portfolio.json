{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One budget-conscious EC2 host for Sentinel and Matching Engine; no NAT or public databases.",
  "Parameters": {
    "HostAmi": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned host image. The release helper reuses the running host's image so routine releases never replace the instance and its database disk."
    }
  },
  "Resources": {
    "Network": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.70.0.0/24",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "CidrBlock": "10.70.0.0/26",
        "MapPublicIpOnLaunch": true,
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "PublicWeb": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS and HTTP only; administration uses Session Manager",
        "VpcId": {
          "Ref": "Network"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "portfolio-demo-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-release-bundles",
              "Status": "Enabled",
              "Prefix": "releases/",
              "ExpirationInDays": 7
            },
            {
              "Id": "expire-backups",
              "Status": "Enabled",
              "Prefix": "backups/",
              "ExpirationInDays": 14
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      },
      "DeletionPolicy": "Retain"
    },
    "ArtifactPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Artifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Artifacts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Artifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ApiImage": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "portfolio-demo-sentinel-api",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Keep last ten image versions\", \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 10}, \"action\": {\"type\": \"expire\"}}]}"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      },
      "DeletionPolicy": "Retain"
    },
    "WebImage": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "portfolio-demo-sentinel-web",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Keep last ten image versions\", \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 10}, \"action\": {\"type\": \"expire\"}}]}"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      },
      "DeletionPolicy": "Retain"
    },
    "MatchingImage": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "portfolio-demo-matching-engine",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Keep last ten image versions\", \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 10}, \"action\": {\"type\": \"expire\"}}]}"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      },
      "DeletionPolicy": "Retain"
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadReleaseAndBackUp",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ApiImage",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "WebImage",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "MatchingImage",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${Artifacts.Arn}/releases/*"
                    },
                    {
                      "Fn::Sub": "${Artifacts.Arn}/backups/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Artifacts.Arn}/backups/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Artifacts",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/portfolio-demo/ontario-511-key"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "ssm.${AWS::Region}.amazonaws.com"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "HostAmi"
        },
        "InstanceType": "t3.small",
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "IamInstanceProfile": {
          "Ref": "HostProfile"
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "PublicWeb"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          },
          {
            "Key": "Name",
            "Value": "portfolio-demo"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -eu\ndnf install -y docker python3 cronie logrotate\nsystemctl enable --now docker crond\nsystemctl enable --now amazon-ssm-agent\nmkdir -p /opt/portfolio /usr/local/lib/docker/cli-plugins\ncd /var/tmp\ncurl --retry 5 --retry-delay 3 -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 -o docker-compose-linux-x86_64\ncurl --retry 5 --retry-delay 3 -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64.sha256 -o compose.sha256\nprintf '%s  docker-compose-linux-x86_64\\n' \"$(awk '{print $1}' compose.sha256)\" | sha256sum -c -\ninstall -m 0755 docker-compose-linux-x86_64 /usr/local/lib/docker/cli-plugins/docker-compose\nprintf '%s\\n' 'SystemMaxUse=100M' > /etc/systemd/journald.conf.d-portfolio.tmp\nmkdir -p /etc/systemd/journald.conf.d\nmv /etc/systemd/journald.conf.d-portfolio.tmp /etc/systemd/journald.conf.d/portfolio.conf\nsystemctl restart systemd-journald\ntouch /opt/portfolio/bootstrap-ready\n"
        }
      },
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation"
      ]
    },
    "Address": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Project",
            "Value": "portfolio-demo"
          }
        ]
      }
    },
    "AddressAttachment": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "InstanceId": {
          "Ref": "Host"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "Address",
            "AllocationId"
          ]
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Host"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "Address"
      }
    },
    "ArtifactBucket": {
      "Value": {
        "Ref": "Artifacts"
      }
    },
    "RegistryPrefix": {
      "Value": {
        "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/portfolio-demo-"
      }
    },
    "SentinelUrl": {
      "Value": {
        "Fn::Sub": "https://sentinel.${Address}.sslip.io"
      }
    },
    "MatchingUrl": {
      "Value": {
        "Fn::Sub": "https://exchange.${Address}.sslip.io"
      }
    }
  }
}
