{
    admin off
}

{$SITE_ADDRESS} {
    encode zstd gzip
    request_body {
        max_size 1MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /cesium/* {
        root * /srv
        file_server
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

{$MATCHING_SITE_ADDRESS} {
    encode zstd gzip
    request_body {
        max_size 16KB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    reverse_proxy matching-api:8080
}
